[Unit]
Description=Host Sandbox multi-computer router
Documentation=https://github.com/mistrjirka/host-sandbox

[Service]
LogsDirectory=host-sandbox
StandardOutput=append:%h/.local/state/host-sandbox/router-service.log
StandardError=append:%h/.local/state/host-sandbox/router-service.log
Type=simple
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/host-sandbox/router.env
ExecStart=%h/.local/bin/host-sandbox router
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
